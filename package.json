{
  "name": "octo-studio-commerce",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deploy:check": "node scripts/deployment-readiness.mjs",
    "deploy:check:production": "node scripts/deployment-readiness.mjs --production",
    "smoke:deployed": "node scripts/smoke-deployed.mjs",
    "catalog:export": "npx vite-node --config vitest.config.mts scripts/catalog-export.ts",
    "catalog:sync:categories": "npx vite-node --config vitest.config.mts scripts/sync-hosted-categories.ts",
    "catalog:import:supabase": "npx vite-node --config vitest.config.mts scripts/catalog-import-supabase.ts",
    "catalog:import:media": "npx vite-node --config vitest.config.mts scripts/catalog-import-media.ts",
    "catalog:db-ready": "npx vite-node --config vitest.config.mts scripts/catalog-db-ready.ts",
    "catalog:import:supabase": "npx vite-node --config vitest.config.mts scripts/catalog-import-supabase.ts",
    "catalog:import:media": "npx vite-node --config vitest.config.mts scripts/catalog-import-media.ts",
    "catalog:db-ready": "npx vite-node --config vitest.config.mts scripts/catalog-db-ready.ts",
    "quality": "npm run lint && npm run typecheck && npm run test && npm run build",
    "manufacturing:env": "node scripts/ensure-local-manufacturing-env.mjs",
    "manufacturing:up": "node scripts/ensure-local-manufacturing-env.mjs && node scripts/manufacturing-compose.mjs up",
    "manufacturing:down": "node scripts/manufacturing-compose.mjs down",
    "manufacturing:logs": "node scripts/manufacturing-compose.mjs logs",
    "manufacturing:health": "node scripts/manufacturing-health.mjs",
    "test:manufacturing:live": "node scripts/manufacturing-live-slice.mjs",
    "test:hosted:supabase": "node scripts/hosted-supabase-rls.mjs",
    "test:hosted:acceptance": "node scripts/hosted-supabase-acceptance.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.9.1",
    "@opentelemetry/api": "^1.9.1",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-navigation-menu": "^1.2.22",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^1.31.0",
    "motion": "^13.1.0",
    "next": "16.3.1",
    "next-intl": "^4.13.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.85.0",
    "sanitize-html": "^2.17.7",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.1",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.18.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
