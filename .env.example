# Public application configuration
# Local development default. Production must be https://baskiciftligi.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_YOUTUBE_URL=
# Optional cinematic homepage background. Absolute HTTPS URLs or local public
# paths such as /demo/hero/placeholder.mp4 are accepted. Empty values fall back
# to the bundled placeholder video and poster.
NEXT_PUBLIC_HOME_HERO_VIDEO_URL=
NEXT_PUBLIC_HOME_HERO_POSTER_URL=

# Supabase (required for production auth, persistence, and storage)
NEXT_PUBLIC_SUPABASE_URL=
# Preferred publishable key name (Supabase Dashboard → API → publishable key)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy alias — still supported
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Preferred server-only secret (never expose to browser bundles)
SUPABASE_SECRET_KEY=
# Legacy alias — still supported
SUPABASE_SERVICE_ROLE_KEY=
# Optional: direct Postgres URI for `npx supabase db push --db-url` or migration scripts.
# Supabase Dashboard → Project Settings → Database → Connection string (URI).
DATABASE_URL=
# Optional: Supabase CLI access token (`npx supabase login` stores this locally instead)
SUPABASE_ACCESS_TOKEN=

# Stable across self-hosted Next.js instances
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# Development-only local catalog persistence.
# Only the literal value true enables this flag. false, 0, empty, or missing stay off.
# Never enables a production admin bypass.
ALLOW_DEMO_ADMIN_MUTATIONS=true

# Local /admin password. Never commit the real value. Production uses Supabase roles.
ADMIN_PANEL_PASSWORD=

# Production never reads .octo-data/catalog.json. Without Supabase the
# storefront is empty until a database is configured. Demo import stays
# disabled in production unless this is explicitly true.
# Development/test: keep local JSON catalog + manufacturing even if
# Supabase credentials exist. Ignored in production.
BC_FORCE_LOCAL_PERSISTENCE=true

# Phase 2 — PayTR (integration intentionally inactive until merchant credentials exist)
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
# Planned production callback only. Do not activate PayTR without credentials.
PAYTR_CALLBACK_URL=https://baskiciftligi.com/api/payments/paytr/callback

# Phase 2 — transactional email / optional notifications
RESEND_API_KEY=
EMAIL_FROM=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ORDER_CHAT_ID=

# Dedicated slicer worker, never exposed to the browser and never a Vercel Function.
# Local default. Production must use a hosted HTTPS worker URL, not localhost.
SLICER_QUEUE_URL=
SLICER_WEBHOOK_SECRET=
SLICER_WORKER_SECRET=
SLICER_WORKER_URL=http://127.0.0.1:8788
MANUFACTURING_QUOTE_HMAC_SECRET=
MANUFACTURING_MAX_UPLOAD_BYTES=104857600
MODEL_CONVERTER_URL=

# Official Thingiverse API only. Never scrape HTML or copy embedded page JSON.
# Docs: https://www.thingiverse.com/developers and /developers/swagger
THINGIVERSE_CLIENT_ID=
THINGIVERSE_CLIENT_SECRET=
THINGIVERSE_REDIRECT_URI=
THINGIVERSE_ACCESS_TOKEN=
THINGIVERSE_API_BASE_URL=https://api.thingiverse.com
# Tests only. Do not enable for normal browsing.
THINGIVERSE_FIXTURE_MODE=false

# Optional observability
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
